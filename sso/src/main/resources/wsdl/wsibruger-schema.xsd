<?xml version='1.0' encoding='UTF-8'?><xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:uni="https://unilogin.dk" elementFormDefault="qualified" targetNamespace="https://wsibruger.unilogin.dk/ws" version="1.0">
    <xs:import namespace="https://unilogin.dk" schemaLocation="common/schema-common.xsd"/>

    <!-- Argument types -->
    <xs:complexType name="HentBrugersKontaktpersoner">
        <xs:complexContent>
            <xs:extension base="uni:Credentials">
                <xs:sequence>
                    <xs:element name="instnr" type="uni:Regnr"/>
                    <xs:element name="brugerid" type="xs:string"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="HentKontaktpersonsBrugere">
        <xs:complexContent>
            <xs:extension base="uni:Credentials">
                <xs:sequence>
                    <xs:element minOccurs="0" name="instnr" type="uni:Regnr"/>
                    <xs:element name="brugerid" type="xs:string"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="HentBrugersInstitutionstilknytninger">
        <xs:complexContent>
            <xs:extension base="uni:Credentials">
                <xs:sequence>
                    <xs:element name="brugerid" type="xs:string"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- Return types -->
    <xs:complexType name="HentBrugersKontaktpersonerResponse">
        <xs:sequence>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="kontaktperson" type="uni:Kontaktperson"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="HentKontaktpersonsBrugereResponse">
        <xs:sequence>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="elev" type="uni:Elevbruger"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="HentBrugersInstitutionstilknytningerResponse">
        <xs:sequence>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="institutionstilknytning" type="uni:Institutionstilknytning"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>